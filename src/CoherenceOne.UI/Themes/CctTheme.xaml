<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="CctBg">#FFF7F2E7</Color>
  <Color x:Key="CctStroke">#FF324B5C</Color>
  <Color x:Key="CctCapsule">#FFFFD9A8</Color>
  <Color x:Key="CctCard">#FFFFF1CF</Color>
  <Color x:Key="CctNote">#FFFDFCF8</Color>
  <CornerRadius x:Key="CctCorner">16</CornerRadius>

  <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource CctBg}" />
  <SolidColorBrush x:Key="Brush.Stroke" Color="{StaticResource CctStroke}" />
  <SolidColorBrush x:Key="Brush.Capsule" Color="{StaticResource CctCapsule}" />
  <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource CctCard}" />
  <SolidColorBrush x:Key="Brush.Note" Color="{StaticResource CctNote}" />

  <Style x:Key="CapsuleTitle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Capsule}" />
    <Setter Property="CornerRadius" Value="32" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Brush.Capsule}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Stroke}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource CctCorner}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
