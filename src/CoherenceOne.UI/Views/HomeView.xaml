<UserControl x:Class="CoherenceOne.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:CoherenceOne.UI.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="700">
  <Grid Background="{StaticResource Brush.Bg}" Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <Border Style="{StaticResource CapsuleTitle}">
        <TextBlock Text="CoherenceOne" FontSize="20" />
      </Border>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,24,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Vertical">
        <controls:McsStepper />
        <controls:SceneStrip Margin="0,16,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Vertical">
        <controls:PomodoroRing DisplayText="{Binding RingText}" Height="200" Width="200" />
        <controls:TimelineView Margin="0,16,0,0" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
